################################################################################
# Frontend Environment Variables for Vercel
# Copy this file to .env.local and update with your actual values
# NOTE: .env.local is NOT committed to Git (see .gitignore)
################################################################################

# Backend API Base URL - Points to Railway backend
# LOCAL DEVELOPMENT: Use /api (proxy to http://localhost:8000)
# PRODUCTION: Use your Railway backend URL
BACKEND_API_BASE=BACKEND_API_BASE

################################################################################
# BACKEND VARIABLES (Set on Railway - Reference only)
# Frontend doesn't need these, but documented for reference
################################################################################

# AP_KEY=                                              # Generated on Railway
# APP_NAME=SieuThiThuCung                             # Set on Railway
# APP_URL=https://your-railway-service.up.railway.app # Set on Railway
# BROADCAST_DRIVER=log                                 # Set on Railway
# CACHE_DRIVER=file                                    # Set on Railway
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app # Set on Railway
# DB_CONNECTION=mysql                                  # Set on Railway
# DB_DATABASE=your-db-name                            # Set on Railway
# DB_HOST=your-db-host                                # Set on Railway
# DB_PASSWORD=your-db-password                        # Set on Railway
# DB_PORT=3306                                         # Set on Railway
# DB_USERNAME=your-db-user                            # Set on Railway
